/Data RawData /RunLengthDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 440
  /ImageMatrix [254 0 0 440 0 0]
  /Width 254
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
